# ── pulidevan.com — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your real values.
# VITE_ prefix is required — Vite only exposes VITE_* vars to the browser bundle.

# ── Gemini AI (required) ──────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# ── Telegram Bot (for lead & appointment notifications) ───────────────────────
# 1. Create a bot via @BotFather on Telegram → get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot on Telegram → get your TELEGRAM_CHAT_ID
VITE_TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
VITE_TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# ── Hostinger Deployment ──────────────────────────────────────────────────────
# Run: npm run build
# Upload the entire contents of dist/ to Hostinger public_html/ via FTP or File Manager.
# The .htaccess file in dist/ handles SPA routing automatically.
